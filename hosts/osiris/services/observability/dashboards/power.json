            "mode": "fixed",
            "fixedColor": "#009E73"
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "increase(node_rapl_package_joules_total{host=~\"$host\",job=\"host/node\",path!~\".*mmio.*\"}[$__range]) / 3600",
          "legendFormat": "",
          "editorMode": "code",
          "range": false,
          "instant": true
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "orientation": "horizontal",
        "textMode": "value",
        "wideLayout": true,
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "auto",
        "text": {
          "valueSize": 36
        }
      }
    },
    {
      "id": 4,
      "title": "Energy telemetry",
      "type": "stat",
      "description": "Reporting: scrape and RAPL collector succeeded. Check access: scrape or collector failed. Unavailable: no matching series.",
      "gridPos": {
        "x": 18,
        "y": 0,
        "w": 6,
        "h": 4
      },
      "datasource": {
        "type": "prometheus",
        "uid": "victoriametrics"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "decimals": 0,
          "noValue": "Unavailable",
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "green",
                "value": 1
              }
            ]
          },
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": {
                  "text": "Check access",
                  "color": "red"
                },
                "1": {
                  "text": "Reporting",
                  "color": "green"
                }
              }
            }
          ]
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "node_scrape_collector_success{host=~\"$host\",job=\"host/node\",collector=\"rapl\"} * on(host,job,instance) up{host=~\"$host\",job=\"host/node\"}",
          "legendFormat": "",
          "editorMode": "code",
          "range": false,
          "instant": true
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "orientation": "horizontal",
        "textMode": "value",
        "wideLayout": true,
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "auto",
        "text": {
          "valueSize": 26
        }
      }
    },
    {
      "id": 2,
      "title": "CPU package power",
      "type": "timeseries",
      "description": "CPU package only. The smoothed line helps compare quiet periods before and after changes. Core and graphics domains are already included in the package.",
      "gridPos": {
        "x": 0,
        "y": 4,
        "w": 16,
        "h": 10
      },
      "datasource": {
        "type": "prometheus",
        "uid": "victoriametrics"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "watt",
          "decimals": 1,
          "min": 0,
          "noValue": "Unavailable",
          "color": {
            "mode": "fixed",
            "fixedColor": "#56B4E9"
          },
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "linear",
            "lineWidth": 2,
            "fillOpacity": 10,
            "gradientMode": "none",
            "showPoints": "never",
            "spanNulls": false,
            "axisPlacement": "auto",
            "axisBorderShow": false,
            "axisColorMode": "text",
            "axisLabel": "",
            "scaleDistribution": {
              "type": "linear"
            },
            "stacking": {
              "mode": "none",
              "group": "A"
            },
            "hideFrom": {
              "tooltip": false,
              "viz": false,
              "legend": false
            },
            "thresholdsStyle": {
              "mode": "off"
            }
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "10-minute average"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "#E69F00"
                }
              },
              {
                "id": "custom.fillOpacity",
                "value": 0
              },
              {
                "id": "custom.lineStyle",
                "value": {
                  "fill": "dash",
                  "dash": [
                    6,
                    4
                  ]
                }
              },
              {
                "id": "custom.lineWidth",
                "value": 2
              }
            ]
          }
        ]
      },
      "targets": [
        {
          "refId": "A",
          "expr": "rate(node_rapl_package_joules_total{host=~\"$host\",job=\"host/node\",path!~\".*mmio.*\"}[$__rate_interval])",
          "legendFormat": "Package",
          "editorMode": "code",
          "range": true,
          "instant": false
        },
        {
          "refId": "B",
          "expr": "avg_over_time((rate(node_rapl_package_joules_total{host=~\"$host\",job=\"host/node\",path!~\".*mmio.*\"}[$__rate_interval]))[10m:30s])",
          "legendFormat": "10-minute average",
          "editorMode": "code",
          "range": true,
          "instant": false
        }
      ],
      "options": {
        "legend": {
          "showLegend": true,
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "lastNotNull",
            "mean",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc",
          "hideZeros": false
        }
      }
    },
