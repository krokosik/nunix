{
  "id": null,
  "uid": "nunix-power",
  "title": "Power consumption",
  "description": "CPU package power and energy, with activity context for comparing idle-power changes. Excludes wall-socket electricity.",
  "schemaVersion": 39,
  "version": 2,
  "editable": false,
  "tags": [
    "power",
    "energy",
    "infrastructure"
  ],
  "timezone": "browser",
  "refresh": "30s",
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "templating": {
    "list": [
      {
        "name": "host",
        "label": "Host",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "victoriametrics"
        },
        "query": "label_values(node_rapl_package_joules_total{job=\"host/node\",path!~\".*mmio.*\"}, host)",
        "definition": "label_values(node_rapl_package_joules_total{job=\"host/node\",path!~\".*mmio.*\"}, host)",
        "refresh": 1,
        "multi": false,
        "includeAll": false,
        "current": {
          "text": "osiris",
          "value": "osiris"
        },
        "options": []
      }
    ]
  },
  "annotations": {
    "list": [
      {
        "builtIn": 1,
        "datasource": {
          "type": "grafana",
          "uid": "-- Grafana --"
        },
        "enable": true,
        "hide": true,
        "iconColor": "rgba(0, 211, 255, 1)",
        "name": "Annotations & Alerts",
        "type": "dashboard"
      }
    ]
  },
  "panels": [
    {
      "id": 10,
      "title": "CPU power now",
      "type": "stat",
      "description": "CPU package power, averaged over the rate interval. Excludes drives, PSU losses and TV. Duplicate MMIO counters are excluded.",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 6,
        "h": 4
      },
      "datasource": {
        "type": "prometheus",
        "uid": "victoriametrics"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "watt",
          "decimals": 1,
          "min": 0,
          "noValue": "Unavailable",
          "color": {
            "mode": "fixed",
            "fixedColor": "#56B4E9"
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "rate(node_rapl_package_joules_total{host=~\"$host\",job=\"host/node\",path!~\".*mmio.*\"}[$__rate_interval])",
          "legendFormat": "",
          "editorMode": "code",
          "range": false,
          "instant": true
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "orientation": "horizontal",
        "textMode": "value",
        "wideLayout": true,
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "auto",
        "text": {
          "valueSize": 36
        }
      }
    },
    {
      "id": 5,
      "title": "Average power",
      "type": "stat",
      "description": "Average power across observed samples in the selected range. Gaps are excluded; this is not a whole-system measurement.",
      "gridPos": {
        "x": 6,
        "y": 0,
        "w": 6,
        "h": 4
      },
      "datasource": {
        "type": "prometheus",
        "uid": "victoriametrics"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "watt",
          "decimals": 1,
          "min": 0,
          "noValue": "Unavailable",
          "color": {
            "mode": "fixed",
            "fixedColor": "#E69F00"
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "avg_over_time((rate(node_rapl_package_joules_total{host=~\"$host\",job=\"host/node\",path!~\".*mmio.*\"}[2m]))[$__range:1m])",
          "legendFormat": "",
          "editorMode": "code",
          "range": false,
          "instant": true
