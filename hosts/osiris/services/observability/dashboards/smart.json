              },
              {
                "id": "decimals",
                "value": 1
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Power cycles"
            },
            "properties": [
              {
                "id": "custom.width",
                "value": 120
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Serial"
            },
            "properties": [
              {
                "id": "custom.width",
                "value": 200
              }
            ]
          }
        ]
      },
      "targets": [
        {
          "refId": "A",
          "expr": "smartctl_device{host=~\"$host\",job=\"host/smartctl\",device=~\"$disk\"}",
          "format": "table",
          "instant": true,
          "range": false,
          "editorMode": "code"
        },
        {
          "refId": "B",
          "expr": "max by(device) (smartctl_device_smart_status{host=~\"$host\",job=\"host/smartctl\",device=~\"$disk\"})",
          "format": "table",
          "instant": true,
          "range": false,
          "editorMode": "code"
        },
        {
          "refId": "C",
          "expr": "max by(device) (smartctl_device_temperature{host=~\"$host\",job=\"host/smartctl\",device=~\"$disk\",temperature_type=\"current\"})",
          "format": "table",
          "instant": true,
          "range": false,
          "editorMode": "code"
        },
        {
          "refId": "D",
          "expr": "max by(device) (smartctl_device_capacity_bytes{host=~\"$host\",job=\"host/smartctl\",device=~\"$disk\"})",
          "format": "table",
          "instant": true,
          "range": false,
          "editorMode": "code"
        },
        {
          "refId": "E",
          "expr": "max by(device) (smartctl_device_power_on_seconds{host=~\"$host\",job=\"host/smartctl\",device=~\"$disk\"})",
          "format": "table",
          "instant": true,
          "range": false,
          "editorMode": "code"
        },
        {
          "refId": "F",
          "expr": "max by(device) (smartctl_device_power_cycle_count{host=~\"$host\",job=\"host/smartctl\",device=~\"$disk\"})",
          "format": "table",
          "instant": true,
          "range": false,
          "editorMode": "code"
        }
      ],
      "options": {
        "showHeader": true,
        "cellHeight": "md",
        "footer": {
          "show": false
        },
        "sortBy": [
          {
            "displayName": "Serial",
            "desc": false
          }
        ]
      },
      "transformations": [
        {
          "id": "joinByField",
          "options": {
            "byField": "device",
            "mode": "outerTabular"
          }
        },
        {
          "id": "filterFieldsByName",
          "options": {
            "include": {
              "names": [
                "model_name",
                "serial_number",
                "Value #B",
                "Value #C",
                "Value #D",
                "Value #E",
                "Value #F"
              ]
            }
          }
        },
        {
          "id": "organize",
          "options": {
            "indexByName": {
              "model_name": 0,
              "serial_number": 1,
              "Value #B": 2,
              "Value #C": 3,
              "Value #D": 4,
              "Value #E": 5,
              "Value #F": 6
            },
            "renameByName": {
              "model_name": "Model",
              "serial_number": "Serial",
              "device": "Device",
              "protocol": "Protocol",
              "firmware_version": "Firmware",
              "Value #B": "SMART",
              "Value #C": "Temperature",
              "Value #D": "Capacity",
              "Value #E": "Power-on time",
              "Value #F": "Power cycles"
            }
          }
        }
      ]
    },
