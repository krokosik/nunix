    {
      "id": 1,
      "title": "Drive temperatures",
      "type": "timeseries",
      "description": "Current sensor temperature per drive. Legend names are serial numbers; use the inventory below to identify the model.",
      "datasource": {
        "type": "prometheus",
        "uid": "victoriametrics"
      },
      "gridPos": {
        "x": 0,
        "y": 4,
        "w": 16,
        "h": 9
      },
      "fieldConfig": {
        "defaults": {
          "unit": "celsius",
          "noValue": "Unavailable",
          "decimals": 1,
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "linear",
            "lineWidth": 2,
            "fillOpacity": 4,
            "showPoints": "never",
            "spanNulls": false,
            "axisPlacement": "auto",
            "axisBorderShow": false,
            "axisColorMode": "text",
            "axisLabel": "",
            "scaleDistribution": {
              "type": "linear"
            },
            "stacking": {
              "mode": "none",
              "group": "A"
            },
            "thresholdsStyle": {
              "mode": "off"
            }
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "(smartctl_device_temperature{host=~\"$host\",job=\"host/smartctl\",device=~\"$disk\",temperature_type=\"current\"}) * on(host,instance,device) group_left(model_name,serial_number,protocol,firmware_version) smartctl_device{host=~\"$host\",job=\"host/smartctl\",device=~\"$disk\"}",
          "legendFormat": "{{serial_number}}",
          "editorMode": "code",
          "instant": false,
          "range": true,
          "format": "time_series"
        }
      ],
      "options": {
        "legend": {
          "showLegend": true,
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "lastNotNull",
            "min",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "id": 20,
      "title": "NVMe endurance & spare",
      "type": "bargauge",
      "description": "Manufacturer estimates. Endurance used is the percentage of rated life consumed and can exceed 100%. Available spare is remaining spare capacity; compare it with the device-reported threshold in diagnostics. These fields do not apply to HDDs.",
      "datasource": {
        "type": "prometheus",
        "uid": "victoriametrics"
      },
      "gridPos": {
        "x": 16,
        "y": 4,
        "w": 8,
        "h": 9
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "noValue": "Unavailable",
          "decimals": 0,
          "color": {
            "mode": "fixed",
            "fixedColor": "#56B4E9"
          },
          "min": 0,
          "max": 100
        },
        "overrides": [
          {
            "matcher": {
              "id": "byFrameRefID",
              "options": "A"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "#E69F00"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byFrameRefID",
              "options": "B"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "#009E73"
                }
              }
            ]
          }
        ]
      },
      "targets": [
        {
          "refId": "A",
          "expr": "(smartctl_device_percentage_used{host=~\"$host\",job=\"host/smartctl\",device=~\"$disk\"}) * on(host,instance,device) group_left(model_name,serial_number,protocol,firmware_version) smartctl_device{host=~\"$host\",job=\"host/smartctl\",device=~\"$disk\"}",
          "legendFormat": "Endurance used · {{serial_number}}",
          "editorMode": "code",
          "instant": true,
          "range": false,
          "format": "time_series"
        },
        {
          "refId": "B",
          "expr": "(smartctl_device_available_spare{host=~\"$host\",job=\"host/smartctl\",device=~\"$disk\"}) * on(host,instance,device) group_left(model_name,serial_number,protocol,firmware_version) smartctl_device{host=~\"$host\",job=\"host/smartctl\",device=~\"$disk\"}",
          "legendFormat": "Available spare · {{serial_number}}",
          "editorMode": "code",
          "instant": true,
          "range": false,
          "format": "time_series"
        }
      ],
      "options": {
        "orientation": "horizontal",
        "displayMode": "basic",
        "showUnfilled": true,
        "valueMode": "color",
        "namePlacement": "top",
        "sizing": "auto",
        "minVizHeight": 16,
        "maxVizHeight": 32,
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "text": {
          "titleSize": 14,
          "valueSize": 28
        }
      }
    },
    {
      "id": 10,
      "title": "Drive inventory",
      "type": "table",
      "description": "Latest reported values. Power-on time is lifetime operating time, not calendar age. SMART status is a firmware self-assessment. Missing fields are shown as a dash, never a fabricated zero.",
      "datasource": {
        "type": "prometheus",
        "uid": "victoriametrics"
      },
      "gridPos": {
        "x": 0,
        "y": 13,
        "w": 24,
        "h": 7
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 0,
          "noValue": "—",
          "custom": {
            "align": "left",
            "cellOptions": {
              "type": "auto"
            },
            "inspect": false,
            "filterable": false
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "SMART"
            },
            "properties": [
              {
                "id": "custom.width",
                "value": 100
              },
              {
                "id": "mappings",
