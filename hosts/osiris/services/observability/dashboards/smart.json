{
  "id": null,
  "uid": "ce8j0dmrrej9cc",
  "title": "Disk health",
  "description": "Drive health, temperatures, ATA sector counters and NVMe endurance from native SMART metrics.",
  "schemaVersion": 39,
  "version": 1,
  "editable": false,
  "tags": [
    "storage",
    "smart",
    "observability"
  ],
  "timezone": "browser",
  "refresh": "30s",
  "time": {
    "from": "now-24h",
    "to": "now"
  },
  "graphTooltip": 1,
  "annotations": {
    "list": []
  },
  "templating": {
    "list": [
      {
        "name": "host",
        "label": "Host",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "victoriametrics"
        },
        "query": "label_values(smartctl_device{job=\"host/smartctl\"}, host)",
        "definition": "label_values(smartctl_device{job=\"host/smartctl\"}, host)",
        "refresh": 1,
        "sort": 1,
        "multi": false,
        "includeAll": false,
        "current": {
          "text": "osiris",
          "value": "osiris"
        },
        "options": []
      },
      {
        "name": "disk",
        "label": "Drive",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "victoriametrics"
        },
        "query": "query_result(smartctl_device{host=~\"$host\",job=\"host/smartctl\"})",
        "definition": "query_result(smartctl_device{host=~\"$host\",job=\"host/smartctl\"})",
        "regex": "/device=\"(?<value>[^\"]+)\".*serial_number=\"(?<text>[^\"]+)\"/",
        "refresh": 1,
        "sort": 1,
        "multi": true,
        "includeAll": true,
        "allValue": ".*",
        "current": {
          "text": [
            "All"
          ],
          "value": [
            "$__all"
          ]
        },
        "options": []
      }
    ]
  },
  "panels": [
    {
      "id": 13,
      "title": "Drives reporting",
      "type": "stat",
      "description": "Number of drives with SMART identity metrics in the selected host and drive filter. Excluded devices are not counted.",
      "datasource": {
        "type": "prometheus",
        "uid": "victoriametrics"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 6,
        "h": 4
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "noValue": "Unavailable",
          "decimals": 0,
          "color": {
            "mode": "fixed",
            "fixedColor": "#56B4E9"
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "count(smartctl_device{host=~\"$host\",job=\"host/smartctl\",device=~\"$disk\"})",
          "legendFormat": "",
          "editorMode": "code",
          "instant": true,
          "range": false,
          "format": "time_series"
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "orientation": "horizontal",
        "textMode": "value",
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "auto",
        "wideLayout": true,
        "text": {
          "valueSize": 36
        }
      }
    },
    {
      "id": 12,
      "title": "SMART failures",
      "type": "stat",
      "description": "Count of drives failing the firmware SMART self-assessment. A passing status does not rule out individual warning signals or future failures.",
      "datasource": {
        "type": "prometheus",
        "uid": "victoriametrics"
      },
      "gridPos": {
        "x": 6,
        "y": 0,
        "w": 6,
        "h": 4
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "noValue": "Unavailable",
          "decimals": 0,
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 1
              }
            ]
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(smartctl_device_smart_status{host=~\"$host\",job=\"host/smartctl\",device=~\"$disk\"} == bool 0)",
          "legendFormat": "",
          "editorMode": "code",
          "instant": true,
          "range": false,
          "format": "time_series"
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "orientation": "horizontal",
        "textMode": "value",
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "auto",
        "wideLayout": true,
        "text": {
          "valueSize": 36
        }
      }
    },
    {
      "id": 22,
      "title": "Hottest drive",
      "type": "stat",
      "description": "Highest current temperature among selected drives. Temperature limits vary by model; no universal alarm threshold is assumed.",
      "datasource": {
        "type": "prometheus",
        "uid": "victoriametrics"
      },
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 6,
        "h": 4
      },
      "fieldConfig": {
        "defaults": {
          "unit": "celsius",
          "noValue": "Unavailable",
          "decimals": 0,
          "color": {
            "mode": "fixed",
            "fixedColor": "#E69F00"
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "max(smartctl_device_temperature{host=~\"$host\",job=\"host/smartctl\",device=~\"$disk\",temperature_type=\"current\"})",
          "legendFormat": "",
          "editorMode": "code",
          "instant": true,
          "range": false,
          "format": "time_series"
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "orientation": "horizontal",
        "textMode": "value",
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "auto",
        "wideLayout": true,
        "text": {
          "valueSize": 36
        }
      }
    },
    {
